/* =========================
   STATE
========================= */

let cart=[];
let currentCategory="all";


/* =========================
   RENDER PRODUCTS
========================= */

function renderProducts(list){

const container=document.getElementById("products");

container.innerHTML="";

document.getElementById("resultCount").innerText=
list.length+" ta mahsulot";

if(list.length===0){

container.innerHTML=
`<div class="empty">
<h2>😕 Mahsulot topilmadi</h2>
<p>Boshqa qidiruv so'zini yoki filtrni sinab ko'ring.</p>
</div>`;

return;
}

list.forEach((p,index)=>{

const oldPrice=Math.round(p[2]/(1-p[4]/100));

container.innerHTML+=`

<div class="product">

<div class="product-image">

<img src="${p[3]}" alt="${p[0]}">

${p[4]>0?
`<div class="discount">-${p[4]}%</div>`:""}

<button
class="favorite"
onclick="favorite(this)">
♡
</button>

</div>

<div class="product-info">

<div class="category-name">${p[1]}</div>

<h3>${p[0]}</h3>

<div class="rating">
★★★★★
</div>

<div class="price">

${p[4]>0?
`<div class="old-price">${format(oldPrice)} so'm</div>`:""}

<div class="new-price">
${format(p[2])} so'm
</div>

</div>

<button class="add" onclick="addToCart(${indexOfProduct(p)})">
🛒 Savatga qo'shish
</button>

</div>

</div>

`;

});

}


/* =========================
   SEARCH + FILTER
========================= */

function filterProducts(){

const search=
document.getElementById("search").value.toLowerCase();

const category=
document.getElementById("categoryFilter").value;

const min=
Number(document.getElementById("minPrice").value)||0;

const max=
Number(document.getElementById("maxPrice").value)||Infinity;

const sort=
document.getElementById("sort").value;

let list=products.filter(p=>{

const matchSearch=
p[0].toLowerCase().includes(search);

const matchCategory=
category==="all" || p[1]===category;

const matchPrice=
p[2]>=min && p[2]<=max;

return matchSearch && matchCategory && matchPrice;

});

if(sort==="low")
list.sort((a,b)=>a[2]-b[2]);

if(sort==="high")
list.sort((a,b)=>b[2]-a[2]);

if(sort==="name")
list.sort((a,b)=>a[0].localeCompare(b[0]));

renderProducts(list);

}


/* =========================
   CATEGORY
========================= */

function setCategory(category){

currentCategory=category;

document.getElementById("categoryFilter").value=
category==="all"?"all":category;

document.getElementById("shop").scrollIntoView({
behavior:"smooth"
});

filterProducts();

}


/* =========================
   CART
========================= */

function addToCart(index){

const existing=
cart.find(item=>item.index===index);

if(existing){
existing.qty++;
}else{
cart.push({
index:index,
qty:1
});
}

updateCart();

alert("✅ Mahsulot savatga qo'shildi!");

}


function updateCart(){

document.getElementById("cartCount").innerText=
cart.reduce((sum,item)=>sum+item.qty,0);

const container=
document.getElementById("cartItems");

container.innerHTML="";

if(cart.length===0){

container.innerHTML=
`<div class="empty">
<h2>🛒</h2>
<p>Savat bo'sh</p>
</div>`;

document.getElementById("cartTotal").innerText="0";

return;
}

let total=0;

cart.forEach((item,pos)=>{

const p=products[item.index];

total+=p[2]*item.qty;

container.innerHTML+=`

<div class="cart-item">

<img src="${p[3]}">

<div class="cart-item-info">

<h4>${p[0]}</h4>

<strong>${format(p[2])} so'm</strong>

<div class="qty">

<button onclick="changeQty(${pos},-1)">−</button>

<span>${item.qty}</span>

<button onclick="changeQty(${pos},1)">+</button>

<button
class="remove"
onclick="removeItem(${pos})">
🗑
</button>

</div>

</div>

</div>

`;

});

document.getElementById("cartTotal").innerText=
format(total);

}


function changeQty(pos,value){

cart[pos].qty+=value;

if(cart[pos].qty<=0){
cart.splice(pos,1);
}

updateCart();

}


function removeItem(pos){

cart.splice(pos,1);

updateCart();

}


function openCart(){

document.getElementById("cartOverlay")
.classList.add("show");

updateCart();

}


function closeCart(){

document.getElementById("cartOverlay")
.classList.remove("show");

}


/* =========================
   CHECKOUT
========================= */

function openCheckout(){

if(cart.length===0){

alert("Savat bo'sh!");

return;

}

closeCart();

document.getElementById("checkoutModal")
.classList.add("show");

}


function closeCheckout(){

document.getElementById("checkoutModal")
.classList.remove("show");

}


function confirmOrder(){

const name=
document.getElementById("customerName").value;

const phone=
document.getElementById("phone").value;

const address=
document.getElementById("address").value;

if(!name || !phone || !address){

alert("⚠️ Iltimos, ism, telefon va manzilni kiriting.");

return;

}

const orderNumber=
"TZ-"+Math.floor(Math.random()*900000+100000);

alert(
"🎉 Buyurtma qabul qilindi!\n\n"+
"Buyurtma №: "+orderNumber+
"\nMijoz: "+name+
"\nTelefon: "+phone+
"\n\nTez orada siz bilan bog'lanamiz."
);

cart=[];

updateCart();

closeCheckout();

document.getElementById("customerName").value="";
document.getElementById("phone").value="";
document.getElementById("address").value="";
document.getElementById("comment").value="";

}


/* =========================
   FAVORITE
========================= */

function favorite(button){

button.classList.toggle("active");

button.innerText=
button.classList.contains("active")?"♥":"♡";

}


/* =========================
   HELPERS
========================= */

function format(number){

return new Intl.NumberFormat("uz-UZ")
.format(number);

}

function indexOfProduct(product){

return products.indexOf(product);

}


/* START */

renderProducts(products);

</script>

